JIRA_DOMAIN=https://your-domain.atlassian.net
JIRA_EMAIL=usuario@empresa.com
JIRA_TOKEN=seu-token-aqui
JIRA_PROJECT=TO
JIRA_FILTER_ID=11083
JIRA_MAX_RESULTS=100
# JQL do filtro "Abertos" (pode sobrescrever)
JIRA_FILTER_JQL=project = "TO" AND resolution = Unresolved AND status IN (Aberto, "Aguardando cliente", "Aplicar Script", Consultoria, "Em Atendimento Nível 2", "Em Atendimento Nível 3", "Esperando o Cliente", "Nível 2", "Nível 3") ORDER BY assignee ASC, "Time to resolution" ASC
PORT=3000

# ===== Auth Google (dominio azi.com.br) =====
# Client ID do OAuth 2.0 (Web) criado no Google Cloud Console
GOOGLE_CLIENT_ID=468468031672-ho90n38klttt4f29vv0u3j2bp467d024.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=azi.com.br
ADMIN_EMAIL=fredson.sousa@azi.com.br
DB_PATH=data/users.db

# ===== Pipefy =====
# Personal Access Token (My Profile -> Personal Access Tokens)
PIPEFY_TOKEN=
# ID do pipe de destino (numeros da URL do pipe)
PIPEFY_PIPE_ID=
# URL da API GraphQL (default: https://api.pipefy.com/graphql)
PIPEFY_API_URL=https://api.pipefy.com/graphql
# Mapeamento de campos do pipe (field_id) — descubra via GET /api/pipefy/pipe
PIPEFY_FIELD_TITLE=title
PIPEFY_FIELD_DESCRIPTION=description
PIPEFY_FIELD_JIRA_KEY=jira_key
PIPEFY_FIELD_STATUS=status
PIPEFY_FIELD_PRIORITY=priority
PIPEFY_FIELD_ASSIGNEE=assignee

# ===== Confluence (Notas de Release) =====
# URL base do Confluence Cloud (sem barra final)
CONFLUENCE_BASE_URL=https://aztecnologia.atlassian.net/wiki
# E-mail da conta Atlassian com acesso ao Confluence
CONFLUENCE_EMAIL=usuario@empresa.com
# API Token do Confluence (id.atlassian.com/manage-profile/security/api-tokens)
CONFLUENCE_TOKEN=seu-api-token-do-confluence
# CQL para filtrar paginas de notas de release
CONFLUENCE_CQL=type=page AND title ~ "Nota de Release"
# Limite de paginas por sincronizacao
CONFLUENCE_LIMIT=50

# ===== TWG (CLI para busca no Confluence) =====
# Caminho do executavel do TWG. Se vazio, o app procura automaticamente:
# - Windows: "twg" no PATH (ex.: C:\Users\<usuario>\AppData\Local\Programs\twg\bin\twg.exe)
# - Linux (container): /opt/twg/bin/twg
TWG_BIN=

# Montagens usadas pelo docker-compose (deploy Linux/Coolify).
# No Windows local o app roda nativamente e nao precisa destas variaveis.
TWG_BIN_HOST=/home/casa/.local/bin
TWG_CONFIG_HOST=/home/casa/.config/twg